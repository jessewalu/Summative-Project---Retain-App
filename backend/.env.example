# Copy this file to .env and adjust the values.

PORT=4000
NODE_ENV=development

# PostgreSQL connection string.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/retain
# Hosted databases usually need SSL (used when NODE_ENV=production). Set to false to turn it off.
# DATABASE_SSL=false

# Long random string used to sign login tokens. REQUIRED in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Where the React app runs (comma separate several origins if needed).
CLIENT_URL=http://localhost:5173

# The admin account created automatically the first time the server starts.
ADMIN_NAME=Retain Admin
ADMIN_EMAIL=admin@retain.app
ADMIN_PASSWORD=Admin123!
